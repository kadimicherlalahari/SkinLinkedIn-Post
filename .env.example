# Copy to .env and fill in. Never commit .env.

# Required
GEMINI_API_KEY=your-gemini-key
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Recommended: only this chat may use the bot (your own chat ID).
# Leave empty to accept messages from any chat. Send /start to the bot and check the logs to find your ID.
TELEGRAM_CHAT_ID=your-chat-id

# Optional
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.7
# Model for the note gate and post quality check (defaults to GEMINI_MODEL). Use a cheap, fast model.
GEMINI_EVAL_MODEL=gemini-3.5-flash-lite
VOICE_SKILL_PATH=skills/meera-pillai-voice/SKILL.md
